{
  "manifest_version": 3,
  "name": "Passhand",
  "version": "0.4.0",
  "description": "Fills logins from your Mac's Keychain when your AI agent asks. The password never passes through the AI.",
  "key": "",
  "minimum_chrome_version": "110",
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Passhand logins" },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "permissions": ["nativeMessaging", "scripting", "tabs", "alarms"],
  "host_permissions": ["<all_urls>"]
}
