{
  "manifest_version": 3,
  "name": "Passhand",
  "version": "0.4.0",
  "description": "Lets AI agents in Claude desktop or Claude Code log in from your Mac's Keychain. Doesn't work from Claude's Chrome side panel.",
  "key": "",
  "minimum_chrome_version": "110",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "Passhand logins",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" }
  },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "permissions": ["nativeMessaging", "scripting", "tabs", "alarms"],
  "host_permissions": ["<all_urls>"]
}
